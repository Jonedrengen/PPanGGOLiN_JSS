# a config file for PPanGGOLiN, you can copy this file and rename it and edit the values to your needs

#PATH parameters
project_clone_path=path/to/PPanGGOLiN_JSS
conda_source_path=path/to/conda.sh
conda_env_name=ppanggolin_joss

#mode (not other modes are supported as of 25082026)
mode=slurm

#SLURM parameters (if mode set to slurm)
cpus_allocated=1
mem_allocated=4G
partition=project
job_name=pangolin_joss
